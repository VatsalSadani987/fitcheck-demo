# Copy these into Vercel: Project, Settings, Environment Variables. Never commit real values.
KAPSO_API_KEY=            # Kapso, API keys page
KAPSO_PHONE_NUMBER_ID=1421064467751314
KAPSO_WEBHOOK_SECRET=     # shown by Kapso when you create the webhook
SITE_URL=https://fitcheck-demo-five.vercel.app

# Database (needed for the live Insights page and for WhatsApp conversations to be remembered).
# Vercel: Storage, Upstash Redis, Connect to project. It adds these automatically:
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Optional
ADMIN_KEY=                # any password you choose; lets you press "Clear test data" on the Insights page
GEMINI_API_KEY=           # free key from Google AI Studio: adds an AI-written summary on the Insights page
# GEMINI_MODEL=gemini-2.5-flash
